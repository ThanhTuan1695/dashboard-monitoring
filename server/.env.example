PORT=4000
MONGODB_URI=mongodb://localhost:27017/monitoring-dashboard
CLIENT_ORIGIN=http://localhost:5173
CHECK_CONCURRENCY=20

# How long status-change history (used for uptime % / timeline charts) is kept before auto-expiring.
HISTORY_RETENTION_DAYS=180

# Down-alert webhook — a Slack incoming-webhook or Teams Incoming Webhook connector URL.
# Leave blank to disable alerting entirely (the default).
ALERT_WEBHOOK_URL=
# Also alert when a device recovers (down -> up), not just when it goes down.
ALERT_ON_RECOVERY=true

# Auth — generate a real random string for JWT_SECRET before deploying,
# e.g. `openssl rand -hex 32`
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=12h

# Encrypts device connector credentials (firewall/switch API tokens, SNMPv3 auth/priv
# passwords) at rest — generate a real random string before storing real credentials,
# e.g. `openssl rand -hex 32`
DEVICE_CREDENTIAL_KEY=change-me-to-a-long-random-string
